rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * BALANCEHUB SECURITY RULES
     * Prioritizes Authorization Independence through denormalization.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Collection Group Rules (CRITICAL for Dashboard "My Debts") ---
    // This rule allows collectionGroup queries on 'debts' across all groups.
    match /{path=**}/debts/{debtId} {
      allow list, get: if isSignedIn() && (
        request.auth.uid == resource.data.debtorId ||
        request.auth.uid == resource.data.groupAdminId ||
        request.auth.uid in resource.data.get('groupMemberIds', [])
      );
    }

    // --- Collection Rules ---

    match /userProfiles/{userId} {
      // Allow any signed-in user to see profiles for group collaboration
      allow get: if isSignedIn();
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update, delete: if isOwner(userId);
    }

    match /groups/{groupId} {
      function isGroupMember(data) {
        return isSignedIn() && request.auth.uid in data.get('memberIds', []);
      }
      function isGroupAdmin(data) {
        return isSignedIn() && request.auth.uid == data.get('adminId', '');
      }

      // Allow listing groups if the user is a member OR searching by invite token
      // This is crucial for both the Dashboard and the Join Group flow.
      allow list: if isSignedIn() && (
        isGroupMember(resource.data) || 
        resource.data.inviteToken != null
      );
      
      allow get: if isSignedIn(); // Necessary for join flow to fetch metadata
      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      allow update, delete: if isGroupAdmin(resource.data);

      match /debts/{debtId} {
        // Nested collection rules for direct access via group path
        function isDebtMember(data) {
          return isSignedIn() && (
            request.auth.uid == data.debtorId || 
            request.auth.uid == data.groupAdminId || 
            request.auth.uid in data.get('groupMemberIds', [])
          );
        }
        function isDebtAdmin(data) {
          return isSignedIn() && request.auth.uid == data.get('groupAdminId', '');
        }

        allow get, list: if isDebtMember(resource.data);
        allow create: if isSignedIn() && request.auth.uid in request.resource.data.get('groupMemberIds', []);
        allow update: if isDebtAdmin(resource.data) || (isDebtMember(resource.data) && request.auth.uid == resource.data.debtorId);
        allow delete: if isDebtAdmin(resource.data);
      }
    }
  }
}