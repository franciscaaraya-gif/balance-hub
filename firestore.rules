
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regla global: permite todo a usuarios autenticados para desarrollo
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // Regla explícita para consultas de grupo de colecciones (Collection Group Queries)
    // Esto es NECESARIO para que queries como collectionGroup('debts') funcionen
    match /{path=**}/debts/{debtId} {
      allow read, write: if request.auth != null;
    }
    
    match /{path=**}/receipts/{receiptId} {
      allow read, write: if request.auth != null;
    }

    match /userProfiles/{userId} {
      allow read, write: if request.auth != null;
    }
    
    match /groups/{groupId} {
      allow read, write: if request.auth != null;
      
      match /debts/{debtId} {
        allow read, write: if request.auth != null;
      }
      
      match /receipts/{receiptId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
