rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    match /userProfiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /groups/{groupId} {
      allow read: if request.auth != null && (resource == null || request.auth.uid in resource.data.memberIds);
      allow create: if request.auth != null && request.resource.data.adminId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.adminId == request.auth.uid;
      
      match /debts/{debtId} {
        allow read: if request.auth != null && (request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds || request.auth.uid == resource.data.debtorId);
        allow create: if request.auth != null && request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.adminId;
        allow update, delete: if request.auth != null && request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.adminId;
      }
      
      match /receipts/{receiptId} {
         allow read, write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
      }
    }

    match /events/{eventId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.creatorId;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.creatorId;
    }
    
    match /{path=**}/debts/{debtId} {
      allow read, list: if request.auth != null && resource.data.debtorId == request.auth.uid;
    }
  }
}