rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funciones auxiliares
    function isSignedIn() {
      return request.auth != null;
    }

    // Regla para deudas (Soporta collectionGroup para "Mis Deudas" y queries de subcolección)
    match /{path=**}/debts/{debtId} {
      // allow read cubre 'get' y 'list'. 
      // Para 'list', Firestore valida que la query incluya filtros que garanticen estas condiciones.
      allow read: if isSignedIn() && (
        resource.data.debtorId == request.auth.uid ||
        resource.data.groupAdminId == request.auth.uid ||
        request.auth.uid in resource.data.get('groupMemberIds', [])
      );
      
      allow create: if isSignedIn() && (
        request.auth.uid == request.resource.data.groupAdminId ||
        request.auth.uid in request.resource.data.get('groupMemberIds', [])
      );

      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.groupAdminId ||
        (request.auth.uid == resource.data.debtorId && request.resource.data.status == 'under_review')
      );

      allow delete: if isSignedIn() && request.auth.uid == resource.data.groupAdminId;
    }

    // Regla para perfiles de usuario
    match /userProfiles/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Regla para grupos
    match /groups/{groupId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.adminId ||
        request.auth.uid in resource.data.get('memberIds', []) ||
        // Permitir búsqueda por inviteToken durante el join (limitado para seguridad)
        (request.query.limit <= 5)
      );
      
      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.adminId ||
        // Permitir unirse o solicitar salida
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberIds', 'members', 'memberStatuses'])
      );
      
      allow delete: if isSignedIn() && request.auth.uid == resource.data.adminId;
    }
  }
}