rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funciones de utilidad
    function isSignedIn() {
      return request.auth != null;
    }

    // Reglas para Perfiles de Usuario
    match /userProfiles/{userId} {
      // Permitir leer perfiles si estás autenticado para ver nombres en listas
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Reglas para Grupos
    match /groups/{groupId} {
      allow read: if isSignedIn() && (
        resource.data.memberIds != null && 
        request.auth.uid in resource.data.memberIds
      );
      
      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.adminId ||
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberIds', 'members', 'memberStatuses'])
      );
      
      allow delete: if isSignedIn() && request.auth.uid == resource.data.adminId;

      // Reglas para Deudas dentro de un grupo específico
      match /debts/{debtId} {
        // Permitir lectura si el usuario es miembro del grupo (usando campos denormalizados)
        allow read: if isSignedIn() && (
          resource.data.groupMemberIds != null && 
          request.auth.uid in resource.data.groupMemberIds
        );
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if isSignedIn() && request.auth.uid == resource.data.groupAdminId;
      }
    }

    // REGLA PARA CONSULTAS GLOBALES (collectionGroup)
    // Se autoriza el listado global basándose en el debtorId o membresía de grupo
    match /{path=**}/debts/{debtId} {
      allow list: if isSignedIn() && (
        (resource.data.debtorId != null && resource.data.debtorId == request.auth.uid) ||
        (resource.data.groupMemberIds != null && request.auth.uid in resource.data.groupMemberIds)
      );
      allow get: if isSignedIn();
    }
  }
}