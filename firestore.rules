rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Regla global: permite todo a usuarios autenticados
    // Nota: Para Collection Group Queries, se requieren las reglas con {path=**} de abajo.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // Regla específica para consultas globales (Collection Group) de deudas
    match /{path=**}/debts/{debtId} {
      allow read, write: if request.auth != null;
    }

    // Regla específica para consultas globales (Collection Group) de boletas
    match /{path=**}/receipts/{receiptId} {
      allow read, write: if request.auth != null;
    }

    // Reglas para perfiles de usuario
    match /userProfiles/{userId} {
      allow read, write: if request.auth != null;
    }

    // Reglas para grupos y sus subcolecciones
    match /groups/{groupId} {
      allow read, write: if request.auth != null;

      match /debts/{debtId} {
        allow read, write: if request.auth != null;
      }

      match /receipts/{receiptId} {
        allow read, write: if request.auth != null;
      }
    }
    
    // Reglas para eventos de asistencia
    match /events/{eventId} {
      allow read, write: if request.auth != null;
    }
  }
}