
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regla global de desarrollo
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // Regla necesaria para consultas de grupo de colecciones (collectionGroup)
    // Firestore requiere que los grupos de colecciones tengan una regla que coincida con su nombre
    match /{path=**}/debts/{debtId} {
      allow read, write: if request.auth != null;
    }
    
    match /{path=**}/receipts/{receiptId} {
      allow read, write: if request.auth != null;
    }

    match /userProfiles/{userId} {
      allow read, write: if request.auth != null;
    }
  }
}
