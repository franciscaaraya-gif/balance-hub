
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regla global de desarrollo: permite todo a usuarios autenticados
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // Reglas explícitas para consultas de grupo de colecciones (collectionGroup)
    // Firestore requiere que los nombres de las colecciones coincidan exactamente en las reglas
    match /{path=**}/debts/{debtId} {
      allow read, write: if request.auth != null;
    }
    
    match /{path=**}/receipts/{receiptId} {
      allow read, write: if request.auth != null;
    }

    match /userProfiles/{userId} {
      allow read, write: if request.auth != null;
    }
  }
}
