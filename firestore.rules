
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Perfiles de usuario: Solo el dueño lee/escribe su perfil completo
    match /userProfiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Grupos: Acceso de Nivel 1 (Membresía completa)
    match /groups/{groupId} {
      // Solo miembros ven los detalles del grupo y lista de miembros
      allow read: if request.auth != null && request.auth.uid in resource.data.memberIds;
      allow write: if request.auth != null && request.auth.uid == resource.data.adminId;
      
      // Deudas dentro del grupo
      match /debts/{debtId} {
        // Nivel 1: Miembros del grupo ven todas las deudas
        // Nivel 2: Asistentes de eventos (no miembros) ven SOLO su propia deuda
        allow read: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds ||
          request.auth.uid == resource.data.debtorId
        );
        allow write: if request.auth != null && request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.adminId;
      }
      
      // Boletas: Solo miembros (Nivel 1)
      match /receipts/{receiptId} {
         allow read, write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
      }
    }

    // Eventos: Permitir lectura y actualización para el flujo de RSVP y Check-in
    match /events/{eventId} {
      // Cualquier usuario logueado puede ver el evento para unirse
      allow read: if request.auth != null;
      // Solo el creador borra o cambia configuración base
      allow create: if request.auth != null && request.auth.uid == request.resource.data.creatorId;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.creatorId;
    }
    
    // Regla de escape para deudas (Nivel 2): El deudor siempre puede leer su propia deuda
    match /{path=**}/debts/{debtId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.debtorId;
    }
  }
}
