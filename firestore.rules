rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Reglas para Deudas (Soporta collectionGroup)
    match /{path=**}/debts/{debtId} {
      // Permitir lectura si eres el deudor, el admin del grupo o un miembro del grupo
      allow read: if isSignedIn() && (
        resource.data.debtorId == request.auth.uid ||
        resource.data.groupAdminId == request.auth.uid ||
        (resource.data.groupMemberIds != null && request.auth.uid in resource.data.groupMemberIds)
      );
      
      // Permitir creación si eres admin o miembro (validando datos de entrada)
      allow create: if isSignedIn() && (
        request.resource.data.groupAdminId == request.auth.uid ||
        request.auth.uid in request.resource.data.groupMemberIds
      );

      // Permitir actualización si eres el admin o si el deudor marca para revisión
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.groupAdminId ||
        (request.auth.uid == resource.data.debtorId && request.resource.data.status == 'under_review')
      );

      allow delete: if isSignedIn() && request.auth.uid == resource.data.groupAdminId;
    }

    // Reglas para Perfiles de Usuario
    match /userProfiles/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // Reglas para Grupos
    match /groups/{groupId} {
      allow read: if isSignedIn() && (
        resource.data.adminId == request.auth.uid ||
        request.auth.uid in resource.data.memberIds ||
        // Permitir ver el grupo temporalmente para unirse vía token
        request.query.limit <= 1
      );
      
      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.adminId ||
        // Permitir unirse al grupo añadiendo el ID a memberIds
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberIds', 'members', 'memberStatuses'])
      );
      
      allow delete: if isSignedIn() && request.auth.uid == resource.data.adminId;
    }
  }
}