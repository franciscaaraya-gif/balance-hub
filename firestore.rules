rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // REGLA NUCLEAR: Permite cualquier operación a usuarios autenticados.
    // El comodín {path=**} es fundamental para que collectionGroup funcione.
    match /{path=**} {
      allow read, write: if request.auth != null;
    }
  }
}