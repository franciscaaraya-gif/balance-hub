rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funciones auxiliares para claridad y reutilización
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Regla para deudas (Soporta collectionGroup y acceso directo)
    // El patrón {path=**} es CRÍTICO para que funcionen las consultas de "Mis Deudas"
    match /{path=**}/debts/{debtId} {
      allow read: if isSignedIn() && (
        resource.data.debtorId == request.auth.uid ||
        resource.data.groupAdminId == request.auth.uid ||
        request.auth.uid in resource.data.groupMemberIds
      );
      
      allow create: if isSignedIn() && (
        request.auth.uid == request.resource.data.groupAdminId ||
        request.auth.uid in request.resource.data.groupMemberIds
      );

      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.groupAdminId ||
        (request.auth.uid == resource.data.debtorId && request.resource.data.status == 'under_review')
      );

      allow delete: if isSignedIn() && request.auth.uid == resource.data.groupAdminId;
    }

    // Regla para perfiles de usuario
    match /userProfiles/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // Regla para grupos
    match /groups/{groupId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.adminId ||
        request.auth.uid in resource.data.memberIds ||
        // Permitir que un usuario vea el grupo si tiene el token de invitación (limitando la query)
        request.query.limit <= 10
      );
      
      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.adminId ||
        // Permitir unirse al grupo (solo modificando campos de membresía)
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberIds', 'members', 'memberStatuses'])
      );
      
      allow delete: if isSignedIn() && request.auth.uid == resource.data.adminId;
    }
  }
}