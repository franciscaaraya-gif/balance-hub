rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * BALANCEHUB SECURITY RULES
     * Prioritiza la independencia de autorización mediante la desnormalización.
     */

    // --- Funciones de Ayuda ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Reglas de Grupo de Colecciones (CRÍTICO para "Mis Deudas") ---
    match /{path=**}/debts/{debtId} {
      // Permite listar deudas si el usuario es el deudor, el admin o un miembro del grupo.
      // Firestore validará que la consulta del cliente incluya los filtros correspondientes.
      allow list, get: if isSignedIn() && (
        request.auth.uid == resource.data.debtorId ||
        request.auth.uid == resource.data.groupAdminId ||
        request.auth.uid in resource.data.get('groupMemberIds', [])
      );
      
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.groupAdminId || 
        (request.auth.uid == resource.data.debtorId && request.resource.data.status == 'under_review')
      );
      
      allow delete: if isSignedIn() && request.auth.uid == resource.data.groupAdminId;
    }

    // --- Reglas de Colecciones Principales ---

    match /userProfiles/{userId} {
      allow get: if isSignedIn();
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update, delete: if isOwner(userId);
    }

    match /groups/{groupId} {
      function isGroupMember(data) {
        return isSignedIn() && request.auth.uid in data.get('memberIds', []);
      }
      function isGroupAdmin(data) {
        return isSignedIn() && request.auth.uid == data.get('adminId', '');
      }

      // Permite listar grupos si el usuario es miembro o si busca por token de invitación
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      allow update, delete: if isGroupAdmin(resource.data);

      match /debts/{debtId} {
        // Estas reglas son redundantes debido al match /{path=**} de arriba, 
        // pero se mantienen para mayor claridad en el acceso directo por ruta.
        allow create: if isSignedIn() && request.auth.uid in request.resource.data.get('groupMemberIds', []);
      }
    }
  }
}