rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // REGLAS DE DEPURACIÓN: Acceso total para cualquier usuario autenticado
    // Esto nos permitirá confirmar si el error es de permisos o estructural
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}