rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funciones de utilidad
    function isSignedIn() {
      return request.auth != null;
    }

    // Reglas para Perfiles de Usuario
    match /userProfiles/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Reglas para Grupos
    match /groups/{groupId} {
      allow read: if isSignedIn() && (
        resource.data.memberIds != null && 
        request.auth.uid in resource.data.memberIds
      );
      
      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.adminId ||
        (request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberIds', 'members', 'memberStatuses']))
      );
      
      allow delete: if isSignedIn() && request.auth.uid == resource.data.adminId;
    }

    // REGLA GLOBAL PARA DEUDAS (Soporta collectionGroup y consultas anidadas)
    // Para que una consulta de collectionGroup funcione, la regla debe ser simple
    // y coincidir exactamente con los filtros aplicados en el cliente.
    match /{path=**}/debts/{debtId} {
      
      // Permitir lectura si el usuario es el deudor O es miembro del grupo.
      // Firestore validará la consulta si se filtra por debtorId == auth.uid
      // o si se consulta dentro de un grupo donde el usuario es miembro.
      allow read: if isSignedIn() && (
        resource.data.debtorId == request.auth.uid ||
        request.auth.uid in resource.data.groupMemberIds
      );
      
      allow create: if isSignedIn();
      
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.groupAdminId ||
        (resource.data.debtorId == request.auth.uid && request.resource.data.status == 'under_review')
      );
      
      allow delete: if isSignedIn() && request.auth.uid == resource.data.groupAdminId;
    }
  }
}