rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * BALANCEHUB SECURITY RULES
     *
     * Core Philosophy:
     * Enforces identity-based and collaborative access. 
     * Support for collectionGroup queries is enabled via recursive wildcards.
     */

    // --- Helper Functions ---

    /** @description Checks if the user is authenticated. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** @description Checks if the user UID matches the provided ID. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** @description Checks ownership for existing documents during update/delete. */
    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    /** @description Checks if the user is a member of a group or debt. */
    function isMember(data) {
      return isSignedIn() && (
        (data.memberIds != null && request.auth.uid in data.memberIds) || 
        (data.groupMemberIds != null && request.auth.uid in data.groupMemberIds)
      );
    }

    /** @description Checks if the user is the administrator of the group or debt. */
    function isAdmin(data) {
      return isSignedIn() && (
        (data.adminId != null && request.auth.uid == data.adminId) || 
        (data.groupAdminId != null && request.auth.uid == data.groupAdminId)
      );
    }

    // --- Collection Rules ---

    /**
     * @description Support for collectionGroup('debts') queries.
     * This is required for the "My Debts" view in the dashboard.
     */
    match /{path=**}/debts/{debtId} {
      allow read: if isMember(resource.data);
    }

    /**
     * @description Rules for user profiles.
     */
    match /userProfiles/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for debt groups.
     */
    match /groups/{groupId} {
      allow get, list: if isMember(resource.data);
      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      allow update: if resource != null && isAdmin(resource.data);
      allow delete: if resource != null && isAdmin(resource.data);

      /**
       * @description Rules for debts nested under groups.
       */
      match /debts/{debtId} {
        allow get, list: if isMember(resource.data);
        allow create: if isSignedIn() && request.resource.data.groupId == groupId && request.auth.uid in request.resource.data.groupMemberIds;
        allow update: if resource != null && (isAdmin(resource.data) || isMember(resource.data));
        allow delete: if resource != null && isAdmin(resource.data);
      }
    }
  }
}