rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Regla para Deudas (Crucial para collectionGroup)
    // El patrón {path=**} permite que las consultas de grupo de colecciones funcionen
    match /{path=**}/debts/{debtId} {
      allow read: if isSignedIn() && (
        resource.data.debtorId == request.auth.uid ||
        resource.data.groupAdminId == request.auth.uid ||
        (resource.data.groupMemberIds != null && request.auth.uid in resource.data.groupMemberIds)
      );
      
      allow create: if isSignedIn();
      
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.groupAdminId ||
        (request.auth.uid == resource.data.debtorId && request.resource.data.status == 'under_review')
      );

      allow delete: if isSignedIn() && request.auth.uid == resource.data.groupAdminId;
    }

    // Reglas para Perfiles de Usuario
    match /userProfiles/{userId} {
      // Permitir leer cualquier perfil si estás logueado (necesario para ver nombres en grupos)
      allow read: if isSignedIn();
      // Solo el dueño puede escribir su perfil
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Reglas para Grupos
    match /groups/{groupId} {
      allow read: if isSignedIn();
      
      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.adminId ||
        // Permitir unirse al grupo si se conoce el token o se añade el ID
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberIds', 'members', 'memberStatuses'])
      );
      
      allow delete: if isSignedIn() && request.auth.uid == resource.data.adminId;
    }
  }
}