rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * BALANCEHUB SECURITY RULES
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Collection Group Rules (CRITICAL for Dashboard "My Debts") ---
    // This allows query(collectionGroup(db, 'debts'), where('debtorId', '==', uid))
    match /{path=**}/debts/{debtId} {
      allow list: if isSignedIn() && (
        (resource.data.debtorId != null && request.auth.uid == resource.data.debtorId) ||
        (resource.data.groupAdminId != null && request.auth.uid == resource.data.groupAdminId) ||
        (resource.data.groupMemberIds != null && request.auth.uid in resource.data.groupMemberIds)
      );
      allow get: if isSignedIn() && (
        (resource.data.debtorId != null && request.auth.uid == resource.data.debtorId) ||
        (resource.data.groupAdminId != null && request.auth.uid == resource.data.groupAdminId) ||
        (resource.data.groupMemberIds != null && request.auth.uid in resource.data.groupMemberIds)
      );
    }

    // --- Collection Rules ---

    match /userProfiles/{userId} {
      // Allow any signed-in user to see profile names/emails for group collaboration
      allow get: if isSignedIn();
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    match /groups/{groupId} {
      function isMember(data) {
        return isSignedIn() && data.memberIds != null && request.auth.uid in data.memberIds;
      }
      function isAdmin(data) {
        return isSignedIn() && data.adminId != null && request.auth.uid == data.adminId;
      }

      allow get, list: if isMember(resource.data);
      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      allow update: if isAdmin(resource.data);
      allow delete: if isAdmin(resource.data);

      match /debts/{debtId} {
        // Internal rules for direct subcollection access
        function isDebtMember(data) {
          return isSignedIn() && data.groupMemberIds != null && request.auth.uid in data.groupMemberIds;
        }
        function isDebtAdmin(data) {
          return isSignedIn() && data.groupAdminId != null && request.auth.uid == data.groupAdminId;
        }

        allow get, list: if isDebtMember(resource.data);
        allow create: if isDebtMember(request.resource.data);
        allow update: if isDebtAdmin(resource.data) || (isDebtMember(resource.data) && request.auth.uid == resource.data.debtorId);
        allow delete: if isDebtAdmin(resource.data);
      }
    }
  }
}