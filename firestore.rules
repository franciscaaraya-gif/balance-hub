rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // MODO DESARROLLO TOTAL: Permitir lectura y escritura en todos los documentos
    // Esto soluciona los errores de permisos en collectionGroup y subcolecciones.
    match /{document=**} {
      allow read, write: if true;
    }

    // Regla explícita para el grupo de colecciones 'debts'
    match /{path=**}/debts/{debtId} {
      allow read, write: if true;
    }
    
    // Regla explícita para el grupo de colecciones 'receipts'
    match /{path=**}/receipts/{receiptId} {
      allow read, write: if true;
    }
  }
}