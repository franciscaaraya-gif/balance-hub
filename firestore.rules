rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // REGLA NUCLEAR: Permitimos lectura y escritura a cualquier usuario autenticado
    // en cualquier parte de la base de datos, incluyendo subcolecciones (collectionGroup).
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}