rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // PASO 1: Permitimos todo a usuarios autenticados para limpiar el error de permisos
    // Esto incluye colecciones raíz y cualquier nivel de subcolecciones (collectionGroup)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}