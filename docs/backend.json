
{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user's profile information and role within the BalanceHub application.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string" }
      },
      "required": ["id", "email", "displayName", "role"]
    },
    "Group": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Group",
      "type": "object",
      "description": "Represents a debt group.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "fixedAmount": { "type": "number" },
        "adminId": { "type": "string" },
        "inviteLink": { "type": "string", "format": "uri" },
        "memberIds": { "type": "array", "items": { "type": "string" } },
        "transferDetails": { "type": "string", "description": "Bank account details for transfers." }
      },
      "required": ["id", "name", "type", "adminId", "inviteLink"]
    },
    "Debt": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Debt",
      "type": "object",
      "description": "Represents an individual debt record.",
      "properties": {
        "id": { "type": "string" },
        "groupId": { "type": "string" },
        "debtorId": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string" },
        "description": { "type": "string" },
        "receiptId": { "type": "string", "description": "Optional reference to a parsed receipt." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "groupId", "debtorId", "amount", "status", "createdAt"]
    },
    "Event": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Event",
      "type": "object",
      "description": "Represents an attendance event for cost splitting.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "location": { "type": "string" },
        "totalCost": { "type": "number" },
        "creatorId": { "type": "string" },
        "participantIds": { "type": "array", "items": { "type": "string" } },
        "presentIds": { "type": "array", "items": { "type": "string" } },
        "externalGuests": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "addedBy": { "type": "string" }
            }
          } 
        }
      },
      "required": ["id", "title", "date", "totalCost", "creatorId"]
    }
  },
  "auth": {
    "providers": ["password", "google.com"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/userProfiles/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": { "$ref": "#/backend/entities/UserProfile" },
          "description": "Stores individual user profile information."
        }
      },
      {
        "path": "/groups/{groupId}",
        "definition": {
          "entityName": "Group",
          "schema": { "$ref": "#/backend/entities/Group" },
          "description": "Stores information about debt groups."
        }
      },
      {
        "path": "/events/{eventId}",
        "definition": {
          "entityName": "Event",
          "schema": { "$ref": "#/backend/entities/Event" },
          "description": "Stores attendance events and cost splits."
        }
      }
    ]
  }
}
