
{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user's profile information and role within the BalanceHub application.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string" }
      },
      "required": ["id", "email", "displayName", "role"]
    },
    "Group": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Group",
      "type": "object",
      "description": "Represents a debt group.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "fixedAmount": { "type": "number" },
        "adminId": { "type": "string" },
        "inviteLink": { "type": "string", "format": "uri" },
        "memberIds": { "type": "array", "items": { "type": "string" } },
        "transferDetails": { "type": "string", "description": "Bank account details for transfers." }
      },
      "required": ["id", "name", "type", "adminId", "inviteLink"]
    },
    "Debt": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Debt",
      "type": "object",
      "description": "Represents an individual debt record.",
      "properties": {
        "id": { "type": "string" },
        "groupId": { "type": "string" },
        "debtorId": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string" },
        "description": { "type": "string" },
        "receiptId": { "type": "string", "description": "Optional reference to a parsed receipt." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "groupId", "debtorId", "amount", "status", "createdAt"]
    },
    "Receipt": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Receipt",
      "type": "object",
      "description": "A scanned bill with items that can be split among members.",
      "properties": {
        "id": { "type": "string" },
        "groupId": { "type": "string" },
        "imageUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "processing", "completed"] },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "price": { "type": "number" },
              "claims": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "userId": { "type": "string" },
                    "percentage": { "type": "number" }
                  }
                }
              }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "groupId", "status", "items", "createdAt"]
    }
  },
  "auth": {
    "providers": ["password", "google.com"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/userProfiles/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": { "$ref": "#/backend/entities/UserProfile" },
          "description": "Stores individual user profile information."
"
        }
      },
      {
        "path": "/groups/{groupId}",
        "definition": {
          "entityName": "Group",
          "schema": { "$ref": "#/backend/entities/Group" },
          "description": "Stores information about debt groups."
        }
      },
      {
        "path": "/groups/{groupId}/debts/{debtId}",
        "definition": {
          "entityName": "Debt",
          "schema": { "$ref": "#/backend/entities/Debt" },
          "description": "Stores individual debt records."
        }
      },
      {
        "path": "/groups/{groupId}/receipts/{receiptId}",
        "definition": {
          "entityName": "Receipt",
          "schema": { "$ref": "#/backend/entities/Receipt" },
          "description": "Stores parsed receipts and their split status."
        }
      }
    ]
  }
}
